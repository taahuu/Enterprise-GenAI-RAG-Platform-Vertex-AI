# Copy to .env and edit. Real environment variables override this file.

# --- Models (Hugging Face, downloaded on first run, then cached) ---
EMBEDDING_BACKEND=hf                       # hf | hash (offline, tests) | vertex
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_BACKEND=hf                             # hf | extractive (no model) | vertex
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct       # bigger = better answers, e.g. Qwen/Qwen2.5-1.5B-Instruct, google/flan-t5-large
DEVICE=auto                                # auto | cpu | cuda
# HF_TOKEN=hf_xxx                          # only for gated models (e.g. Llama)

# --- Vector store ---
VECTOR_BACKEND=numpy                       # numpy | faiss
INDEX_DIR=data/index

# --- Chunking / retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
FETCH_K=20
MIN_SCORE=0.25                             # dense/lexical high-confidence gate
FALLBACK_MIN_SCORE=0.10                    # weak matches go to low-confidence LLM instead of immediate refusal
QUERY_REWRITE=1                            # rewrite identity-style filler and synonym questions
HEADER_BOOST=0.05                          # ranking-only boost for identity questions in first chunk
HYBRID_ALPHA=0.7                           # weight of dense similarity vs keyword coverage
MMR_LAMBDA=0.7

# --- API ---
API_KEY=                                   # set to require an X-API-Key header
MAX_UPLOAD_MB=25
RAG_PRELOAD=1                              # load models at startup

# --- Optional Vertex AI backend ---
# GCP_PROJECT=my-project
# GCP_LOCATION=us-central1
# VERTEX_EMBEDDING_MODEL=gemini-embedding-001
# VERTEX_LLM_MODEL=gemini-2.5-flash
